-- FIXED: Added CreateLabeledDivider since Rayfield doesn't have it
function MainTab:CreateLabeledDivider(text)
	local TabPage = self.TabPage
	local Elements = TabPage.Parent
	local Divider = Elements.Template.Divider:Clone()
	Divider.Name = "LabeledDivider"
	Divider.Visible = true
	Divider.Parent = TabPage
	Divider.BackgroundTransparency = 1
	Divider.Size = UDim2.new(1, -10, 0, 20)

	Divider.Divider:Destroy()

	local LeftLine = Instance.new("Frame")
	LeftLine.Name = "LeftLine"
	LeftLine.AnchorPoint = Vector2.new(0, 0.5)
	LeftLine.Position = UDim2.new(0, 0, 0.5, 0)
	LeftLine.Size = UDim2.new(0.5, -(#text * 3.5) - 10, 0, 1)
	LeftLine.BackgroundColor3 = customTheme.ElementStroke
	LeftLine.BackgroundTransparency = 0.85
	LeftLine.BorderSizePixel = 0
	LeftLine.Parent = Divider

	local Label = Instance.new("TextLabel")
	Label.Name = "Title"
	Label.AnchorPoint = Vector2.new(0.5, 0.5)
	Label.Position = UDim2.new(0.5, 0, 0.5, 0)
	Label.Size = UDim2.new(0, #text * 7, 0, 14)
	Label.BackgroundTransparency = 1
	Label.Text = text
	Label.TextColor3 = customTheme.TextColor
	Label.TextTransparency = 0.4
	Label.Font = Enum.Font.Gotham
	Label.TextSize = 12
	Label.Parent = Divider

	local RightLine = Instance.new("Frame")
	RightLine.Name = "RightLine"
	RightLine.AnchorPoint = Vector2.new(1, 0.5)
	RightLine.Position = UDim2.new(1, 0, 0.5, 0)
	RightLine.Size = UDim2.new(0.5, -(#text * 3.5) - 10, 0, 1)
	RightLine.BackgroundColor3 = customTheme.ElementStroke
	RightLine.BackgroundTransparency = 0.85
	RightLine.BorderSizePixel = 0
	RightLine.Parent = Divider

	return Divider
end

